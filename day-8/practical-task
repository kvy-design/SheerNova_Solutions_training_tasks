// From a list of orders with personId and amount, return each person with their total amount, sorted from highest to lowest.
console.log("10.")
let getTotalAmountById = orders.reduce((acc,curr) =>{
    if(!acc[curr.personId]){
        acc[curr.personId] = 0
    }

    acc[curr.personId] += curr.amount
    return acc
},{})
let sortAmount = Object.entries(getTotalAmountById).sort((a,b) =>  b[1] - a[1])
console.log(sortAmount)

