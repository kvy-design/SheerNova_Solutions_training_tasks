console.log("3.") //Return only the people in one city.
let sameCity = people.reduce((acc,curr) => {
    if(!acc[curr.city]){
        acc[curr.city] = 0
    }
    acc[curr.city] ++

    return acc
},{})
let uniquePeople = people.filter(
    person => sameCity[person.city] === 1
);
const uniqueNames = uniquePeople.map(
    person => person.name
);

console.log("people from one city : ",uniqueNames);



